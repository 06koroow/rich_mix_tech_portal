  function getActColorObj(colorId) {
    return ACT_COLORS.find((c) => c.id === colorId) || ACT_COLORS[0];
  }

  function getHomeRunConfig(sheet) {
    return Object.assign({}, DEFAULT_HOME_RUN, (sheet && sheet.homeRun) ? sheet.homeRun : {});
  }

  /* ---- Room I/O Presets Store ---- */
  function getAllRoomIOPresets() {
    let list = store.read('room_io_presets', null);
    if (!Array.isArray(list) || !list.length) {
      list = JSON.parse(JSON.stringify(DEFAULT_ROOM_IO_PRESETS));
      store.write('room_io_presets', list);
    }
    return list.slice();
  }

  function getRoomIOPresetForSpace(spaceName) {
    const list = getAllRoomIOPresets();
    return list.find((p) => p.space === spaceName) || list[0] || null;
  }

  function saveRoomIOPreset(preset) {
    const list = getAllRoomIOPresets();
    const idx = list.findIndex((p) => p.id === preset.id || p.space === preset.space);
    const updated = Object.assign({
      id: preset.id || store.uid('room_io'),
      updatedAt: Date.now(),
      createdAt: preset.createdAt || Date.now()
    }, preset);

    if (idx > -1) {
      list[idx] = updated;
    } else {
      list.push(updated);
    }
    store.write('room_io_presets', list);
    return updated;
  }

  function applyRoomIOPresetToSheet(sheet, roomPreset) {
    if (!sheet || !roomPreset) return;
    if (roomPreset.homeRun) {
      sheet.homeRun = JSON.parse(JSON.stringify(roomPreset.homeRun));
    }
    if (Array.isArray(roomPreset.stageboxes)) {
      sheet.stageboxes = JSON.parse(JSON.stringify(roomPreset.stageboxes));
      // Ensure acts are linked properly
      const defaultActId = (sheet.acts && sheet.acts[0]) ? sheet.acts[0].id : 'act-house';
      sheet.stageboxes.forEach((box) => {
        (box.channels || []).forEach((ch) => {
          if (!ch.actId || ch.actId === 'act-house') {
            ch.actId = defaultActId;
          }
        });
      });
    }
  }

  /* ---- Database / Storage Access ---- */
  function getAllPresets() {
    let list = store.read('patch_presets', null);
    if (!Array.isArray(list) || !list.length) {
      list = DEFAULT_INPUT_PRESETS.concat(DEFAULT_OUTPUT_PRESETS);
      store.write('patch_presets', list);
    }
    return list.slice();
  }

  function getInputs() {
    return getAllPresets().filter((p) => p.type === 'input');
  }

  function getOutputs() {
    return getAllPresets().filter((p) => p.type === 'output');
  }

  function getPreset(id) {
    return getAllPresets().find((p) => p.id === id) || null;
  }

  function savePreset(preset) {
    const list = getAllPresets();
    const idx = list.findIndex((p) => p.id === preset.id);
    const updated = Object.assign({
      id: preset.id || store.uid('pre'),
      updatedAt: Date.now(),
      createdAt: preset.createdAt || Date.now()
    }, preset);

    if (idx > -1) {
      list[idx] = updated;
    } else {
      list.push(updated);
    }
    store.write('patch_presets', list);
    return updated;
  }

  function removePreset(id) {
    const list = getAllPresets().filter((p) => p.id !== id);
    store.write('patch_presets', list);
  }

  function resetPresetDefaults() {
    const defaults = DEFAULT_INPUT_PRESETS.concat(DEFAULT_OUTPUT_PRESETS);
    store.write('patch_presets', defaults);
    return defaults;
  }

